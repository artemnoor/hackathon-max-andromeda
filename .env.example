# Local-only Compose values. Use a URL-safe password (letters, digits, hyphens).
POSTGRES_USER=andromeda
POSTGRES_PASSWORD=andromeda-local-only
POSTGRES_DB=andromeda_dev
ANDROMEDA_HOST_PORT=8020
MAX_TEST_REDIS_PORT=16379
MINI_APP_PORT=8787
MINI_APP_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
MINI_APP_PUBLIC_URL=

# Optional backend conversation AI / response verbalization. Set true and add
# the Polza key locally to enable real DeepSeek requests; never commit the key.
PRESENTATION_LLM_ENABLED=true
POLZA_AI_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
CONVERSATION_AI_TIMEOUT_SECONDS=15
CONVERSATION_AI_RATE_LIMIT_MAX=12

# Jev is opt-in and only uses the repository's calibrated next-action.v1
# operation. Enable both gates only when a provider key is configured. The
# existing Polza key can be reused; TypeSafe/Jev-specific keys take precedence.
JEV_ENABLED=false
JEV_SHADOW_ENABLED=false
JEV_CALIBRATION_ENABLED=false
JEV_CALIBRATION_LOCK_PATH=/app/config/jev/locks/next-action.typesafe-jev.v2.lock.json
JEV_CALIBRATION_MODE=production
JEV_RUNTIME_PROVIDER=typesafe
JEV_ENDPOINT=https://polza.ai/api
JEV_MODEL=typesafe/jev
TYPESAFE_API_KEY=
JEV_API_KEY=

# Required only when starting the optional MAX Bot + Mini App profile.
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
