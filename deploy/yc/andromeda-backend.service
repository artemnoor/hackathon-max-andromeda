[Unit]
Description=Andromeda FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/andromeda/release/backend
Environment=PYTHONPATH=/opt/andromeda/release/backend/src
EnvironmentFile=-/etc/andromeda/backend.env
Environment=ANDROMEDA_ENV=staging
Environment=FRONTEND_ORIGIN=http://127.0.0.1
Environment=LOG_LEVEL=INFO
Environment=ANDROMEDA_DB_POOL_SIZE=5
Environment=ANDROMEDA_DB_MAX_OVERFLOW=10
ExecStart=/opt/andromeda/venv/bin/uvicorn andromeda.api.main:app --host 127.0.0.1 --port 8020
Restart=on-failure
RestartSec=5
User=andromeda
Group=andromeda
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
