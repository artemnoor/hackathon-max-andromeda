{
  "name": "hackathon-max-andromeda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:bot": "tsx watch src/entrypoints/bot.ts",
    "dev:miniapp": "npm run build:miniapp && tsx watch src/entrypoints/miniapp.ts",
    "start:bot": "node dist/src/entrypoints/bot.js",
    "start:miniapp": "node dist/src/entrypoints/miniapp.js",
    "build": "tsc -p tsconfig.json && npm run build:miniapp",
    "prebuild:miniapp": "npm ci --prefix miniapp-frontend",
    "build:miniapp": "vite build miniapp-frontend --config miniapp-frontend/vite.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build:miniapp && npm --prefix miniapp-frontend test && tsx --test tests/**/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage tests/**/*.test.ts",
    "test:integration": "npm run build:miniapp && node scripts/integration-check.mjs",
    "test:browser": "npm run build:miniapp && node scripts/browser-check.mjs",
    "check:miniapp": "npm run build:miniapp && node scripts/miniapp-check.mjs",
    "check:architecture": "node scripts/architecture-check.mjs",
    "generate:andromeda-client": "node scripts/generate-andromeda-client.mjs",
    "check:andromeda-client-drift": "node scripts/check-andromeda-client-drift.mjs",
    "check:env": "node scripts/env-example-check.mjs",
    "check:compose": "node scripts/compose-contract-check.mjs",
    "check:secrets": "node scripts/secret-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "coverage:check": "node scripts/coverage-check.mjs",
    "audit": "npm audit --audit-level=high",
    "verify": "node scripts/check.mjs --full"
  },
  "dependencies": {
    "@maxhub/max-bot-api": "^0.3.1",
    "dotenv": "^16.4.7",
    "ioredis": "5.6.1",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
