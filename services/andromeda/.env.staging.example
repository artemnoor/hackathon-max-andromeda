ANDROMEDA_ENV=staging
ANDROMEDA_DATABASE_URL=postgresql+psycopg://andromeda:change-me@127.0.0.1:5433/andromeda_staging
FRONTEND_ORIGIN=https://andromeda.example.org
LOG_LEVEL=INFO
ANDROMEDA_PROFILE_COOKIE_NAME=andromeda_profile_session
ANDROMEDA_PROFILE_COOKIE_MAX_AGE=2592000
ANDROMEDA_PROFILE_TTL_SECONDS=2592000
ANDROMEDA_PROFILE_COOKIE_SECURE=true
ANDROMEDA_PROFILE_COOKIE_SAMESITE=lax
ANDROMEDA_OPS_API_KEY=replace-with-a-secret-at-least-16-chars

# Jev remains disabled until provider health and a production-ready calibration lock pass.
JEV_ENABLED=false
JEV_SHADOW_ENABLED=false
JEV_CALIBRATION_ENABLED=false
# TYPESAFE_API_KEY=replace-with-a-secret
JEV_ENDPOINT=https://api.typesafe.ai
JEV_MODEL=jev-latest

ANDROMEDA_STAGING_DB=andromeda_staging
ANDROMEDA_STAGING_DB_USER=andromeda
ANDROMEDA_STAGING_DB_PASSWORD=change-me
ANDROMEDA_STAGING_PORT=5433
