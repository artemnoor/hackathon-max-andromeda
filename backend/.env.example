# Development uses PostgreSQL. Copy the root .env.development.example for the
# compose variables; replace change-me with a local-only password.
ANDROMEDA_ENV=development
ANDROMEDA_DATABASE_URL=postgresql+psycopg://andromeda:change-me@127.0.0.1:5432/andromeda_dev
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
ANDROMEDA_PROFILE_COOKIE_NAME=andromeda_profile_session
ANDROMEDA_PROFILE_COOKIE_MAX_AGE=2592000
ANDROMEDA_PROFILE_TTL_SECONDS=2592000
ANDROMEDA_PROFILE_COOKIE_SECURE=false
ANDROMEDA_PROFILE_COOKIE_SAMESITE=lax

# Human identities for source registration; empty means fail closed.
ANDROMEDA_KNOWLEDGE_POLICY_ASSISTANT_ENABLED=false
ANDROMEDA_KNOWLEDGE_SOURCE_STEWARD_ACCOUNT_IDS=
ANDROMEDA_KNOWLEDGE_REVIEWER_ACCOUNT_IDS=
ANDROMEDA_POLICY_STEWARD_ACCOUNT_IDS=

# Optional Jev runtime: disabled by default. Never commit TYPESAFE_API_KEY.
JEV_ENABLED=false
JEV_SHADOW_ENABLED=false
JEV_CALIBRATION_ENABLED=false
# JEV_CALIBRATION_LOCK_PATH=/run/secrets/andromeda/decision-lock.json
# TYPESAFE_API_KEY=replace-with-a-secret
JEV_ENDPOINT=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEVQL_ENABLED=false
JEV_TREE_ENABLED=false
